page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #1A2E28;
  background: #F4F7F5;
  line-height: 1.5;
}

.container {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #0B3D2E;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #6B7C75;
  margin-bottom: 32rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(11, 61, 46, 0.06);
}

.btn-primary {
  background: linear-gradient(135deg, #0B3D2E 0%, #1A6B4F 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 48rpx;
  border: none;
  line-height: 1.4;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #E8F5EF;
  color: #0B3D2E;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-green {
  background: #E8F5EF;
  color: #1A6B4F;
}

.tag-orange {
  background: #FFF3E0;
  color: #E65100;
}

.tag-blue {
  background: #E3F2FD;
  color: #1565C0;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #6B7C75;
}

.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.price {
  color: #0B3D2E;
  font-weight: 600;
}

.price-large {
  font-size: 40rpx;
}

.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.text-muted {
  color: #6B7C75;
}

.text-small {
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background: #E8EDE9;
  margin: 24rpx 0;
}
