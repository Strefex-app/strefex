.session-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(11, 61, 46, 0.06);
}

.session-card--compact {
  padding: 20rpx 24rpx;
}

.session-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.session-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0B3D2E;
  flex: 1;
  min-width: 0;
}

.session-card__meta {
  margin-bottom: 16rpx;
}

.session-card__footer {
  margin-top: 8rpx;
}

.session-card__urgent {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #E65100;
  font-weight: 500;
}

.session-card__full {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9E9E9E;
}
