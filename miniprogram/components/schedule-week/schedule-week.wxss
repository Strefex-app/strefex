.schedule-week {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 0 24rpx;
}

.schedule-week__day {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 120rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  position: relative;
}

.schedule-week__day--active {
  background: #0B3D2E;
}

.schedule-week__day--active .schedule-week__label,
.schedule-week__day--active .schedule-week__num {
  color: #FFFFFF;
}

.schedule-week__day--today {
  border: 2rpx solid #1A6B4F;
}

.schedule-week__label {
  font-size: 22rpx;
  color: #6B7C75;
}

.schedule-week__num {
  font-size: 32rpx;
  font-weight: 600;
  color: #0B3D2E;
  margin-top: 4rpx;
}

.schedule-week__dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  background: #1A6B4F;
  color: #FFFFFF;
  border-radius: 14rpx;
  padding: 0 6rpx;
}

.schedule-week__day--active .schedule-week__dot {
  background: #FFFFFF;
  color: #0B3D2E;
}
