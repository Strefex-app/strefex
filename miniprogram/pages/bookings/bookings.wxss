.booking-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0B3D2E;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.booking-card__footer {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E8EDE9;
}

.booking-card__actions {
  display: flex;
  gap: 12rpx;
}

.booking-card__btn {
  margin: 0 !important;
  font-size: 24rpx !important;
  padding: 0 24rpx !important;
  line-height: 56rpx !important;
  height: 56rpx !important;
}
