.booking-session-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0B3D2E;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.notes-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 26rpx;
  padding: 16rpx;
  background: #F4F7F5;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.booking-submit {
  width: 100%;
  margin-top: 16rpx;
}

.detail-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
