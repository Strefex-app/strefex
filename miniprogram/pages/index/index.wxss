.hero {
  background: linear-gradient(145deg, #0B3D2E 0%, #1A6B4F 100%);
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 40rpx;
  color: #FFFFFF;
}

.hero__title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.hero__subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 32rpx;
}

.hero__cta {
  background: #FFFFFF !important;
  color: #0B3D2E !important;
  font-size: 28rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section__header {
  margin-bottom: 20rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0B3D2E;
  margin-bottom: 20rpx;
}

.section__link {
  font-size: 26rpx;
  color: #1A6B4F;
}

.categories {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(11, 61, 46, 0.05);
}

.category__icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 8rpx;
}

.category__label {
  font-size: 28rpx;
  font-weight: 500;
  color: #0B3D2E;
}
