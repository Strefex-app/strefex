# App
APP_NAME=STREFEX B2B API
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/strefex
DATABASE_ECHO=false

# JWT (use a long random secret in production: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# httpOnly cookie auth (recommended for browser clients)
AUTH_USE_COOKIES=true
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=.yourdomain.com

# Redis (optional — shared rate limits across uvicorn workers)
# REDIS_URL=redis://localhost:6379/0

# Email verification (optional — off by default for backward compatibility)
# REQUIRE_EMAIL_VERIFICATION=true
# EMAIL_VERIFICATION_EXPIRE_HOURS=24
# FRONTEND_URL=http://localhost:5173

# CORS (comma-separated or JSON array)
# CORS_ORIGINS=["http://localhost:5173","https://yourapp.bubble.io"]

# Stripe (payments & subscriptions — 5 tiers: start, basic, standard, premium, enterprise)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BASIC=price_xxx_basic
STRIPE_PRICE_STANDARD=price_xxx_standard
STRIPE_PRICE_PREMIUM=price_xxx_premium
STRIPE_PRICE_ENTERPRISE=price_xxx_enterprise
FRONTEND_URL=http://localhost:5173

# Sentry error tracking (optional)
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_ENVIRONMENT=production

# Firebase Admin (optional — for verifying Firebase ID tokens on backend)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase-service-account.json

# ── PitchBook WeChat mini program (football training) ─────
# WECHAT_MINI_APP_ID=wxXXXXXXXXXXXXXXXX
# WECHAT_MINI_APP_SECRET=your-mini-program-secret
# WECHAT_PAY_MCH_ID=your-merchant-id
# WECHAT_PAY_API_KEY=your-api-v3-key-or-cert-path
# WECHAT_PAY_NOTIFY_URL=https://api.yourdomain.com/api/v1/football/payments/notify/wechat
# ALIPAY_APP_ID=your-alipay-app-id
# ALIPAY_PRIVATE_KEY=path-or-inline-rsa-private-key
# ALIPAY_NOTIFY_URL=https://api.yourdomain.com/api/v1/football/payments/notify/alipay
# ALIPAY_RETURN_URL=https://yourdomain.com/payment/return
